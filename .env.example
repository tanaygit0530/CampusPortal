# Environment Configuration Template for CampusPass (Experiment 10: CI/CD with GitHub Actions, Vercel & Render)

# Backend Environment Variables (configured in Render Dashboard or backend/.env)
PORT=5000
# For MongoDB Atlas cloud database:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/CampusPassDB?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
# Deployed Vercel frontend URL without trailing slash (e.g. https://campuspass.vercel.app):
FRONTEND_URL=https://your-project.vercel.app

# Frontend Environment Variables (configured in Vercel Project Settings or frontend/.env)
# Deployed Render backend URL without trailing slash (e.g. https://campuspass-backend.onrender.com):
VITE_API_URL=https://campusportal-3v0p.onrender.com/
