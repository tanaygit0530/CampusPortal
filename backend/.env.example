# Backend Environment Variables Template
PORT=5000

# MongoDB Connection String
# Local: mongodb://localhost:27017/CampusPassDB
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/CampusPassDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/CampusPassDB

# JWT Authentication Secrets
JWT_SECRET=campuspass_super_secret_jwt_key_2026_exp5_secure!
JWT_EXPIRES_IN=7d

# Bootstrap Administrator (Created at server startup only if no admin exists)
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campuspass.edu
ADMIN_PASSWORD=AdminPassword123!

# Allowed Frontend Origin(s) for Express & Socket.IO CORS (comma-separated, no trailing slash)
FRONTEND_URL=http://localhost:5173,http://localhost:3000