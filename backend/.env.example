# Backend Environment Variables Template (Experiment 10 - Render & Local)

# Port provided by Render automatically in production; defaults to 5000 locally
PORT=5000

# MongoDB Connection String:
# For local MongoDB: mongodb://localhost:27017/campusDB
# For Render deployment with MongoDB Atlas:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/CampusPassDB?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s) for CORS and Socket.IO (comma-separated if multiple, no trailing slash)
# For local development: http://localhost:5173
# For Render production: https://your-project.vercel.app
FRONTEND_URL=https://your-project.vercel.app
